+export const syncStorage = async (req: AuthenticatedRequest, res: Response) => {
+  try {
+    const instituteId = req.user?.instituteId;
+    if (!instituteId) {
+      return res.status(403).json({ message: "No institute linked." });
+    }
+
+    const s3Client = new S3Client({
+      endpoint: process.env.R2_ENDPOINT || "",
+      region: process.env.R2_REGION || "auto",
+      credentials: {
+        accessKeyId: process.env.R2_ACCESS_KEY_ID || "",
+        secretAccessKey: process.env.R2_SECRET_ACCESS_KEY || "",
+      },
+    });
+    const bucketName = process.env.R2_BUCKET_NAME || "";
+
+    let videoBytes = 0;
+    let documentBytes = 0;
+
+    // Helper function to paginate through all objects with a given prefix
+    const calculatePrefixSize = async (prefix: string) => {
+      let totalSize = 0;
+      let isTruncated = true;
+      let continuationToken: string | undefined = undefined;
+
+      while (isTruncated) {
+        const command = new ListObjectsV2Command({
+          Bucket: bucketName,
+          Prefix: prefix,
+          ContinuationToken: continuationToken,
+        });
+        const response = await s3Client.send(command);
+        
+        if (response.Contents) {
+          response.Contents.forEach(obj => {
+            totalSize += obj.Size || 0;
+          });
+        }
+        
+        isTruncated = response.IsTruncated || false;
+        continuationToken = response.NextContinuationToken;
+      }
+      return totalSize;
+    };
+
+    // Only process if we actually have R2 credentials, otherwise just skip
+    if (bucketName) {
+      // We will sum up everything starting with `institutes/{instituteId}/`
+      // Note: we can differentiate docs and videos if we check the key, but to be simple we can just query everything
+      // and sum them up based on if they contain '/videos/' or '/documents/'
+      // But a faster way is to list everything for the institute:
+      let totalSize = 0;
+      let isTruncated = true;
+      let continuationToken: string | undefined = undefined;
+      
+      while (isTruncated) {
+        const command = new ListObjectsV2Command({
+          Bucket: bucketName,
+          Prefix: `institutes/${instituteId}/`,
+          ContinuationToken: continuationToken,
+        });
+        const response = await s3Client.send(command);
+        
+        if (response.Contents) {
+          response.Contents.forEach(obj => {
+            if (obj.Key?.includes('/videos/')) {
+              videoBytes += obj.Size || 0;
+            } else if (obj.Key?.includes('/documents/')) {
+              documentBytes += obj.Size || 0;
+            }
+          });
+        }
+        
+        isTruncated = response.IsTruncated || false;
+        continuationToken = response.NextContinuationToken;
+      }
+    }
+
+    const institute = await Institute.findByIdAndUpdate(
+      instituteId,
+      { storageUsage: { videoBytes, documentBytes } },
+      { new: true }
+    );
+
+    return res.status(200).json({
+      message: "Storage synced successfully",
+      storageUsage: institute?.storageUsage
+    });
+  } catch (error: any) {
+    console.error("Sync storage error:", error);
+    return res.status(500).json({ message: "Internal server error.", error: error.message });
+  }
+};
